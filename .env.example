DATABASE_URL=sqlite:./bgm_rank.db

ADMIN_TOKEN=your_secure_admin_token

# 可选
BGM_TOKEN=your_bangumi_api_token
DEPLOY_HOOK_URL=https://api.cloudflare.com/client/v4/pages/webhooks/deploy_hooks/...
RUST_LOG=info

# MAL API (fetch-mal 子命令必需)
MAL_CLIENT_ID=

# LLM 匹配 (match 子命令，可选)：DEEPSEEK_API_KEY 优先，否则 OPENROUTER_API_KEY；都不设则跳过 LLM 层
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
# LLM prompt 丰富度：low（默认）| high
LLM_PROMPT_MODE=
